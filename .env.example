# Copy to a root-owned /etc/edutechproject/environment on the server (mode 0600).
# No passwords, Git credentials or private keys belong in this repository.
NODE_ENV=production
HOST=127.0.0.1
PORT=3847
BASE_PATH=/edutechproject
APP_ORIGIN=https://79.108.160.80
COOKIE_SECURE=true
TRUST_PROXY=loopback
DATA_DIR=/var/lib/edutechproject
NODE_OPTIONS=--max-old-space-size=96
# Conservative durable-storage caps for the current small shared VPS.
MAX_SESSIONS=1000
MAX_EXAMS=200
MAX_EXAM_SNAPSHOT_BYTES=122880
MAX_TOTAL_EXAM_SNAPSHOT_BYTES=2097152
MAX_QUESTIONS=500
MAX_QUESTION_BYTES=2097152
MAX_REVISIONS=1000
MAX_REVISION_BYTES=4194304
MAX_AUDIT_ENTRIES=5000
COMPLETED_EXAM_RETENTION_DAYS=7
EXPIRED_SESSION_RETENTION_HOURS=24
