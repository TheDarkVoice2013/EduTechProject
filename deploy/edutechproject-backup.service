[Unit]
Description=Consistent local backup of the EduTechProject database
After=edutechproject.service

[Service]
Type=oneshot
User=edutechproject
Group=edutechproject
WorkingDirectory=/opt/edutechproject
EnvironmentFile=/etc/edutechproject/environment
ExecStart=/opt/edutechproject-runtime/bin/node scripts/backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/edutechproject
MemoryMax=96M
CPUQuota=25%
TasksMax=16
LimitFSIZE=134217728
